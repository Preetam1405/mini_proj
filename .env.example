# Copy to .env and edit. Load it with your process manager, Docker --env-file, or `node --env-file=.env`.

PORT=3000
NODE_ENV=production

# Where the SQLite database lives. Back this file up.
DB_PATH=./data/meridian.db

# Time zone used for "today" and appointment slots.
HOSPITAL_TZ=Asia/Kolkata

# First administrator, created on first start if no admin exists. Use a long unique password.
ADMIN_EMAIL=admin@your-hospital.example
ADMIN_PASSWORD=change-me-to-a-long-passphrase

# Sample data and demo accounts. Keep this 0 in production.
DEMO_MODE=0

# Set to 1 when the site is served over HTTPS (it should be).
COOKIE_SECURE=1

# Optional: turns on "Continue with Google". See README.
GOOGLE_CLIENT_ID=
